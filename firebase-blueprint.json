{
  "entities": {
    "Tour": {
      "title": "Tour",
      "description": "A curated travel and tour package in Pakistan",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "destination": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "pricePerPerson": { "type": "number" },
        "durationDays": { "type": "number" },
        "durationNights": { "type": "number" },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "itinerary": { "type": "array" },
        "includedServices": { "type": "array" },
        "excludedServices": { "type": "array" },
        "departureDates": { "type": "array" },
        "meetingPoint": { "type": "string", "maxLength": 200 },
        "difficulty": { "type": "string", "enum": ["Easy", "Moderate", "Challenging", "Strenuous"] },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "published": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "destination", "pricePerPerson", "durationDays"]
    },
    "BookingEnquiry": {
      "title": "BookingEnquiry",
      "description": "A tour booking enquiry initiated by a traveler, tracked in database and coordinated via WhatsApp",
      "type": "object",
      "properties": {
        "tourId": { "type": "string", "maxLength": 128 },
        "tourTitle": { "type": "string", "maxLength": 150 },
        "tourSlug": { "type": "string", "maxLength": 150 },
        "destination": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "travellerName": { "type": "string", "maxLength": 100 },
        "travellerEmail": { "type": "string", "maxLength": 150 },
        "travellerPhone": { "type": "string", "maxLength": 30 },
        "departureDate": { "type": "string", "maxLength": 50 },
        "travellerCount": { "type": "number" },
        "quotedPricePerPerson": { "type": "number" },
        "quotedTotal": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Contacted", "Confirmed", "Cancelled"] },
        "specialRequests": { "type": "string", "maxLength": 1000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tourId", "travellerName", "travellerPhone", "departureDate", "travellerCount", "quotedTotal", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "General customer inquiry message",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["New", "Read", "Replied"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Traveler user profile with authentication and contact preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Subscribed email for travel inspiration and tour updates",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/tours/{tourId}": {
      "schema": "Tour",
      "description": "Catalog of travel and tour packages across Pakistan"
    },
    "/booking_enquiries/{enquiryId}": {
      "schema": "BookingEnquiry",
      "description": "Traveler booking inquiries synced between web app and WhatsApp operations"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "General contact and support inquiries"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user profile details"
    },
    "/newsletter_subscribers/{subId}": {
      "schema": "NewsletterSubscriber",
      "description": "Subscribed newsletter email addresses"
    }
  }
}
