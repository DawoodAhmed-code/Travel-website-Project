# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_AGENT_NUMBER: Travel agency central WhatsApp desk (international digits format e.g. 923008594210)
WHATSAPP_AGENT_NUMBER="923008594210"

# ADMIN_EMAIL: Authorized administrator email (default dawoodahmed0175@gmail.com)
ADMIN_EMAIL="dawoodahmed0175@gmail.com"
